{
  "name": "tbea-knowledge-workspace",
  "version": "0.11.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "npm run test:citations-ui && node scripts/verify-ui.mjs",
    "test:citations-ui": "node scripts/verify-cited-documents.mjs",
    "start": "node dist/server.mjs --config config/local.json",
    "init": "node scripts/init.mjs",
    "doctor": "node scripts/doctor.mjs",
    "pack:offline": "npm run build && node scripts/licenses.mjs && node scripts/offline.mjs",
    "test:offline": "node scripts/verify-offline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.5",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "parse5": "^8.0.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "5.7.284",
    "playwright": "^1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
